#!/bin/bash
# Engine launcher: starts the private local server (if it isn't running) and
# opens the Engine page in your browser. Nothing here touches the internet.
APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
ENGINE_DIR="$(dirname "$APP_DIR")"
[ -f "$ENGINE_DIR/engine/server.py" ] || ENGINE_DIR="$HOME/Documents/Engine"
PORT=7861
LOG="$ENGINE_DIR/logs/engine.log"
mkdir -p "$ENGINE_DIR/logs"

# Already running? Just open the page.
if /usr/bin/curl -s --max-time 1 "http://127.0.0.1:$PORT/api/ping" | grep -q '"engine"'; then
  /usr/bin/open "http://127.0.0.1:$PORT/"
  exit 0
fi

if [ ! -x "$ENGINE_DIR/.venv/bin/python" ]; then
  /usr/bin/osascript -e 'display alert "Engine is not installed yet" message "Open Terminal and run:\n\ncd ~/Documents/Engine && ./setup.sh"'
  exit 1
fi

# keep the log small
if [ -f "$LOG" ] && [ "$(stat -f%z "$LOG")" -gt 5000000 ]; then mv "$LOG" "$LOG.old"; fi

cd "$ENGINE_DIR" || exit 1
export PYTHONPATH="$ENGINE_DIR" PYTHONSAFEPATH=1 HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
nohup "$ENGINE_DIR/.venv/bin/python" -m engine.server --port "$PORT" --open >> "$LOG" 2>&1 &
exit 0
